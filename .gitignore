# ambiente local
.venv/
__pycache__/
*.pyc

# artefatos de compilação do instalador (publicados via GitHub Releases)
installer/Output/

# bibliotecas baixadas para o instalador completo (~350 MB): são geradas por
# installer/baixar_wheels.ps1 a cada compilação, não entram no repositório
installer/vendor/wheels/

# cópia dos notebooks de exemplo: vem do repositório PySusNoCode-Exemplos a
# cada compilação (installer/copiar_exemplos.ps1), para não duplicar arquivo
installer/exemplos/

# saídas de notebook executado a partir daqui (o exemplo das UBS grava o mapa
# na pasta de trabalho): são resultado de teste, não código
*.geojson
